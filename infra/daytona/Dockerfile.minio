FROM golang:1.24-alpine AS builder
RUN CGO_ENABLED=0 GOMAXPROCS=2 go install -p=2 -trimpath -ldflags='-s -w' github.com/minio/minio@RELEASE.2025-09-07T16-13-09Z \
    && mkdir /licenses \
    && cp /go/pkg/mod/github.com/minio/minio@*/LICENSE /licenses/LICENSE \
    && cp /go/pkg/mod/github.com/minio/minio@*/NOTICE /licenses/NOTICE

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /go/bin/minio /usr/local/bin/minio
COPY --from=builder /licenses /usr/share/licenses/minio
LABEL org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.version="RELEASE.2025-09-07T16-13-09Z-source-build"
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
