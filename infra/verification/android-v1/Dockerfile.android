# syntax=docker/dockerfile:1
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
RUN --mount=type=secret,id=proxy_ca,required=true \
    apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update \
    && apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
      libx11-6 libnss3 libxcomposite1 libxcursor1 libxi6 libxtst6 libpulse0 libasound2 \
      libglu1-mesa libxrandr2 libxdamage1 libxfixes3 libxcb1 libvulkan1 libpng16-16 \
      libfreetype6 libdbus-1-3 libxkbcommon0 libexpat1 libdrm2 libxkbfile1 socat \
    && rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]
